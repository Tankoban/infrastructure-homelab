{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTerraformStatePath",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::sugoi-terraform-state-2026",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "homelab/terraform.tfstate",
            "homelab/terraform.tfstate.tflock"
          ]
        }
      }
    },
    {
      "Sid": "AccessTerraformState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::sugoi-terraform-state-2026/homelab/terraform.tfstate"
    },
    {
      "Sid": "ManageTerraformStateLock",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::sugoi-terraform-state-2026/homelab/terraform.tfstate.tflock"
    }
  ]
}
